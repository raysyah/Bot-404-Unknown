# Contoh konfigurasi lokal. Jangan isi token asli lalu unggah ke GitHub.
PORT=3000
VERIFY_TOKEN=ganti_dengan_token_rahasia_acak
WHATSAPP_ACCESS_TOKEN=isi_token_meta_di_lingkungan_aman
PHONE_NUMBER_ID=isi_phone_number_id
GRAPH_API_VERSION=v23.0

# Nomor admin dalam format internasional, angka saja, tanpa +, spasi, atau tanda hubung.
ADMIN_WHATSAPP_NUMBER=628xxxxxxxxxx

STORE_NAME=Moon Light Store
ADMIN_CONTACT_TEXT=Silakan hubungi admin untuk dibantu lebih lanjut.
PAYMENT_INSTRUCTIONS=Hubungi admin untuk mendapatkan instruksi pembayaran resmi. Pesanan diproses setelah pembayaran diperiksa manual.
